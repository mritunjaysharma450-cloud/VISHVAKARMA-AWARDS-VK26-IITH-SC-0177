        </mxCell>
        <mxCell id="text_66" value="SAFETY BOUNDARY&#10;Auxiliary demo only; closed-course only. No wiring into real vehicle horn / headlamp circuits.&#10;Physical override wins if firmware hangs; horn suppression expires locally. Uncertain lighting: no automatic HIGH." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;spacing=0;fontFamily=Arial;fontSize=24.0;fontColor=#20344A;fontStyle=1;lineHeight=1.22;" vertex="1" parent="1" connectable="0">
