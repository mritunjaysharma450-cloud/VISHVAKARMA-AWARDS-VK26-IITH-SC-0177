        </mxCell>
        <mxCell id="text_67" value="LOCAL SAFE RECOVERY | Horn deadman expiry / fault / link loss -&gt; suppression lifts; NC relay makes horn available without coil power.&#10;Stale / unknown lighting -&gt; FREEZE; no automatic HIGH. Physical override cuts actuation, bypasses relay and provides manual HIGH/LOW." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;spacing=0;fontFamily=Arial;fontSize=26.0;fontColor=#20344A;fontStyle=1;lineHeight=1.22;" vertex="1" parent="1" connectable="0">
