        <mxCell id="text_64" value="Regulated controller / UWB tag / optional GPS supply | auxiliary demo horn path | physical override&#10;Local grounds only; no pole-to-vehicle cable. Override cuts automatic actuation; bypass + manual HIGH/LOW remain available." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;spacing=0;fontFamily=Arial;fontSize=24.1;fontColor=#28323D;fontStyle=0;lineHeight=1.22;" vertex="1" parent="swrail" connectable="0">
