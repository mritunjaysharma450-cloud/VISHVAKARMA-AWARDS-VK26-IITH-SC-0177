        </mxCell>
        <mxCell id="text_70" value="DECISION RULE  |  UNKNOWN or ambiguous association cannot authorize a new restriction.&#10;Security is an application-layer design requirement; connectivity alone never authorizes actuation." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#20344A;fontStyle=1;lineHeight=1.22;" vertex="1" parent="1" connectable="0">
